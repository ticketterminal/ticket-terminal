# This whole file is now the *fallback* path — everything here can also be set
# from the running app's Settings page (saved to the gitignored
# data/settings.json, takes effect immediately, no restart). Use this file if
# you'd rather script/pre-seed a setup instead of clicking through the UI, or
# copy it to .env and fill in real values as a one-time bootstrap.
#
# Generate a Jira token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=PROJ

# Where `claude` gets spawned for a ticket that has no workDir of its own.
# Defaults to your home directory if unset.
WMP_DEFAULT_WORKDIR=

# The knowledge-base folder the memory graph reads (.md files, optionally with
# YAML frontmatter — see the Settings page for the exact expected shape).
# Independent of WMP_DEFAULT_WORKDIR above — pointing the terminal at a workdir
# and pointing this feature at a docs folder are different concerns. Defaults
# to Claude Code's own per-workdir memory convention under WMP_DEFAULT_WORKDIR
# if unset.
WMP_MEMORY_DIR=

# Notion as a second ticket source (a database = the project, a page = a
# ticket). Recommended: NOTION_TOKEN = the Internal Integration Secret of an
# *internal* integration in your workspace (share the tickets database with it
# from Notion's "..." → Connections menu), plus the database id or URL. The
# CLIENT_* / REDIRECT values are only for the advanced OAuth path against a
# *public* integration — see the README. The Settings page overrides all five.
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:4173/api/notion/oauth/callback
